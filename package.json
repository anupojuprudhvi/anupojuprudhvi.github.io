{
  "name": "prudhvi-portfolio",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run test:build && npm run test:preview && npm run test:browser",
    "test:build": "node --test scripts/build.test.mjs scripts/check-confidential.test.mjs",
    "test:preview": "node --test scripts/serve.test.mjs",
    "test:browser": "node scripts/verify.mjs",
    "preview": "node scripts/serve.mjs",
    "check": "node scripts/build.mjs --check",
    "confidential": "node scripts/check-confidential.mjs",
    "social": "node scripts/render-social.mjs",
    "stage": "node scripts/stage.mjs",
    "links": "node scripts/check-links.mjs",
    "lighthouse": "npx --yes @lhci/cli@0.15.1 autorun",
    "prepare": "git config core.hooksPath .githooks || exit 0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "playwright": "^1.63.0"
  }
}
